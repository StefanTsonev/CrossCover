{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosscover-recap",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {"bindings": [{"name": "RECAPS", "class_name": "RecapStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RecapStore"]}],
  "observability": {"enabled": false}
}
