+};
+template <typename Response>
+bool windowsHttpFetch(const std::string& url, const char* method, const std::map<std::string, std::string>& headers,
+                      const std::string& basicAuth, const char* body, Response& out) {
+  const auto address = wide(url);
+  URL_COMPONENTS parts{};
+  parts.dwStructSize = sizeof(parts);
+  parts.dwHostNameLength = parts.dwUrlPathLength = parts.dwExtraInfoLength = static_cast<DWORD>(-1);
+  if (!WinHttpCrackUrl(address.c_str(), 0, 0, &parts)) return false;
+  InternetHandle session{WinHttpOpen(L"CrossCover Simulator", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, nullptr, nullptr, 0)};
+  if (!session.value) return false;
+  WinHttpSetTimeouts(session.value, 10000, 10000, 60000, 60000);
+  std::wstring host(parts.lpszHostName, parts.dwHostNameLength);
+  InternetHandle connection{WinHttpConnect(session.value, host.c_str(), parts.nPort, 0)};
+  if (!connection.value) return false;
+  std::wstring path(parts.lpszUrlPath, parts.dwUrlPathLength);
+  if (parts.dwExtraInfoLength) path.append(parts.lpszExtraInfo, parts.dwExtraInfoLength);
+  if (path.empty()) path = L"/";
+  const auto verb = wide(method ? method : "GET");
+  InternetHandle request{WinHttpOpenRequest(connection.value, verb.c_str(), path.c_str(), nullptr, nullptr,
+                                            WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                            parts.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0)};
+  if (!request.value) return false;
+  for (const auto& pair : headers) {
+    const auto header = wide(pair.first + ": " + pair.second);
+    if (!WinHttpAddRequestHeaders(request.value, header.c_str(), static_cast<DWORD>(header.size()),
+                                  WINHTTP_ADDREQ_FLAG_ADD))
+      return false;
+  }
+  if (!basicAuth.empty()) {
+    const auto colon = basicAuth.find(':');
+    const auto user = wide(basicAuth.substr(0, colon));
+    const auto password = wide(colon == std::string::npos ? "" : basicAuth.substr(colon + 1));
+    WinHttpSetCredentials(request.value, WINHTTP_AUTH_TARGET_SERVER, WINHTTP_AUTH_SCHEME_BASIC, user.c_str(),
+                          password.c_str(), nullptr);
+  }
+  const DWORD length = body ? static_cast<DWORD>(strlen(body)) : 0;
+  if (!WinHttpSendRequest(request.value, nullptr, 0, const_cast<char*>(body), length, length, 0) ||
+      !WinHttpReceiveResponse(request.value, nullptr))
+    return false;
+  DWORD status = 0, size = sizeof(status);
+  if (!WinHttpQueryHeaders(request.value, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, nullptr, &status,
+                           &size, nullptr))
+    return false;
+  out.statusCode = static_cast<int>(status);
+  char buffer[8192];
+  DWORD received = 0;
+  while (true) {
+    if (!WinHttpReadData(request.value, buffer, sizeof(buffer), &received)) return false;
+    if (!received) break;
+    out.body.append(buffer, received);
+  }
+  return true;
+}
+}  // namespace sim_http_fetch
