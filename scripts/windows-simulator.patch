diff --git a/src/MD5Builder_windows.h b/src/MD5Builder_windows.h
new file mode 100644
--- /dev/null
+++ b/src/MD5Builder_windows.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <bcrypt.h>
+#include <windows.h>
+
+#include "WString.h"
+class MD5Builder {
+  BCRYPT_ALG_HANDLE algorithm = nullptr;
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  unsigned char digest[16]{};
+
+ public:
+  ~MD5Builder() {
+    if (hash) BCryptDestroyHash(hash);
+    if (algorithm) BCryptCloseAlgorithmProvider(algorithm, 0);
+  }
+  void begin() {
+    if (hash) {
+      BCryptDestroyHash(hash);
+      hash = nullptr;
+    }
+    if (!algorithm) BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_MD5_ALGORITHM, nullptr, 0);
+    if (algorithm) BCryptCreateHash(algorithm, &hash, nullptr, 0, nullptr, 0, 0);
+  }
+  void add(const uint8_t* data, size_t size) {
+    if (hash) BCryptHashData(hash, const_cast<PUCHAR>(data), static_cast<ULONG>(size), 0);
+  }
+  void add(const char* data) {
+    if (data) add(reinterpret_cast<const uint8_t*>(data), strlen(data));
+  }
+  void calculate() {
+    if (hash) BCryptFinishHash(hash, digest, sizeof(digest), 0);
+  }
+  String toString() const {
+    char text[33];
+    for (int i = 0; i < 16; ++i) snprintf(text + i * 2, 3, "%02x", digest[i]);
+    return String(text);
+  }
+};
diff --git a/src/SimulatorSockets.h b/src/SimulatorSockets.h
new file mode 100644
--- /dev/null
+++ b/src/SimulatorSockets.h
@@ -0,0 +1,58 @@
+#pragma once
+#include <climits>
+#include <cstdint>
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using SimSocket = intptr_t;
+#ifndef SHUT_RDWR
+#define SHUT_RDWR SD_BOTH
+#endif
+inline SimSocket simOpenSocket(int family, int type, int protocol) {
+  static const bool initialized = [] {
+    WSADATA data{};
+    return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  }();
+  if (!initialized) return -1;
+  return static_cast<SimSocket>(::socket(family, type, protocol));
+}
+inline SimSocket simAcceptSocket(SimSocket fd, sockaddr* address, int* length) {
+  return static_cast<SimSocket>(::accept(fd, address, length));
+}
+inline int simCloseSocket(SimSocket fd) { return closesocket(fd); }
+inline SimSocket simDupSocket(SimSocket fd) {
+  WSAPROTOCOL_INFO info{};
+  if (WSADuplicateSocket(fd, GetCurrentProcessId(), &info) != 0) return -1;
+  return static_cast<SimSocket>(WSASocket(FROM_PROTOCOL_INFO, FROM_PROTOCOL_INFO, FROM_PROTOCOL_INFO, &info, 0, 0));
+}
+inline int simSend(SimSocket fd, const void* data, size_t size, int flags) {
+  return ::send(fd, static_cast<const char*>(data), static_cast<int>(size > INT_MAX ? INT_MAX : size), flags);
+}
+inline int simRecv(SimSocket fd, void* data, size_t size, int flags) {
+  return ::recv(fd, static_cast<char*>(data), static_cast<int>(size > INT_MAX ? INT_MAX : size), flags);
+}
+inline int simSetSocketOpt(SimSocket fd, int level, int option, const void* data, int size) {
+  if (option == SO_RCVTIMEO || option == SO_SNDTIMEO) {
+    const auto* time = static_cast<const timeval*>(data);
+    const DWORD milliseconds = static_cast<DWORD>(time->tv_sec * 1000 + time->tv_usec / 1000);
+    return ::setsockopt(fd, level, option, reinterpret_cast<const char*>(&milliseconds), sizeof(milliseconds));
+  }
+  return ::setsockopt(fd, level, option, static_cast<const char*>(data), size);
+}
+#else
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+using SimSocket = int;
+#define simOpenSocket ::socket
+#define simAcceptSocket ::accept
+#define simCloseSocket ::close
+#define simDupSocket ::dup
+#define simSend ::send
+#define simRecv ::recv
+#define simSetSocketOpt ::setsockopt
+#endif
